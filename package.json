{
  "name": "konexus",
  "version": "1.4.5",
  "private": true,
  "homepage": "./",
  "main": "electron/main.js",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/react-dom": "^19.0.4",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.518.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-is": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "react-toastify": "^11.0.5",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.22.0",
    "web-vitals": "^2.1.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "start": "vite --host localhost --port 3000 --strictPort",
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc --noEmit && vite build",
    "test": "jest",
    "test:frontend": "jest --runInBand",
    "test:update": "node --test electron/updateAssets.test.js",
    "test:electron": "node --test electron/*.test.js",
    "audit:update": "node scripts/audit-update-flow.mjs",
    "typecheck": "tsc --noEmit",
    "electron:serve": "concurrently -k \"cross-env BROWSER=none npm start\" \"npm run electron:start\"",
    "electron:build": "npm run build && electron-builder",
    "electron:start": "wait-on tcp:3000 && electron .",
    "dist": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.guilherme.konexus",
    "productName": "Konexus",
    "asar": true,
    "extends": null,
    "publish": [
      {
        "provider": "github",
        "owner": "mafaldo-dev",
        "repo": "konexus",
        "releaseType": "release"
      }
    ],
    "files": [
      "build/**/*",
      "electron/**/*",
      "!build/electron.js"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "extraResources": [
      {
        "from": "build/static",
        "to": "static"
      }
    ],
    "directories": {
      "buildResources": "src/assets"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/image/konexus.ico",
      "artifactName": "Konexus-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/assets/image/konexus.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Konexus"
    }
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.7",
    "underscore": "^1.13.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/date-fns": "^2.5.3",
    "@types/jest": "^30.0.0",
    "@types/jspdf": "^1.3.3",
    "@types/react": "^19.1.8",
    "@types/react-input-mask": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.22",
    "babel-jest": "^30.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^12.19.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.31",
    "recharts": "^3.0.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.2"
  }
}
