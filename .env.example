# Variaveis de ambiente do Konexus ERP Frontend (Create React App)
#
# Copie este arquivo para .env para desenvolvimento local.
#
# O CRA expoe ao bundle SOMENTE variaveis com prefixo REACT_APP_ — tudo o
# que estiver aqui e publico. Nunca coloque segredos neste arquivo.
#
# Build de producao: o CRA carrega automaticamente o arquivo .env.production
# (versionado neste repositorio). Nao defina NODE_ENV manualmente aqui; o CRA
# controla esse valor em start/build/test.

# URL base da API do backend (sem barra final).
# Desenvolvimento local:
REACT_APP_API_URL=http://localhost:3010

# URL do Socket.IO em producao. Se omitida/vazia, o cliente usa
# REACT_APP_API_URL como fallback.
REACT_APP_SOCKET_URL=

# URL do Socket.IO usada apenas em desenvolvimento (padrao: http://localhost:3010).
REACT_APP_SOCKET_URL_LOCAL=http://localhost:3010
